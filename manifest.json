{
  "manifest_version": 3,
  "name": "PullDown QR",
  "version": "1.7.0",
  "description": "リンクにマウスカーソルを重ねるだけで、そのURLのQRコードを即座に表示します。クリック不要・完全ローカル処理。",
  "permissions": ["storage", "clipboardWrite", "activeTab"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "PullDown QR",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/vendor/qrcode-generator.js", "src/qr-render.js", "src/defaults.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "PullDown QR のオン/オフを切り替え（MacではOption+Shift+Q）"
    }
  }
}
